{
  "name": "@elirobinson/design-system-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "release": "changeset publish",
    "changeset:version": "changeset version",
    "changeset": "changeset",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "pretest:visual": "nx run-many -t build --projects=storybook,docs",
    "test:visual": "playwright test",
    "test:visual:container": "node scripts/visual-container.mjs",
    "test:visual:update": "node scripts/visual-container.mjs --update-snapshots",
    "visual:diff": "node scripts/visual-diff-pixels.mjs",
    "visual:digest": "node scripts/visual-container.mjs --update-digest",
    "pretypecheck": "nx run-many -t build",
    "typecheck": "tsc --noEmit -p ./tsconfig.typecheck.json",
    "format:check": "prettier --check .",
    "sync:deps": "node scripts/sync-workspace-deps.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@elirobinson/ai-patterns": "workspace:*",
    "@elirobinson/eslint-config": "workspace:*",
    "@eslint/js": "^9.39.4",
    "@nx/eslint": "22.7.0",
    "@nx/storybook": "22.7.0",
    "@nx/vite": "22.7.0",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "22.7.0",
    "prettier": "^3.8.3",
    "storybook": "^10.3.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
