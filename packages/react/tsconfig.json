{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    /* Emit for Node's resolver, not a bundler's: dist/ is loaded directly by
       Vite SSR dev servers, so relative specifiers must carry .js extensions.
       scripts/smoke-dist.mjs enforces this on every build. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["./src/**/*"],
  "exclude": ["./src/**/*.test.tsx", "./src/test"]
}
