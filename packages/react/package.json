{
  "name": "@elirobinson/react",
  "version": "3.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@elirobinson/tokens": "workspace:*",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9"
  },
  "exports": {
    "./styles.css": "./src/styles.css",
    "./styles/*.css": "./src/components/*.css",
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.json"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf dist && tsc -p ./tsconfig.json && node ./scripts/generate-manifest.mjs && node ./scripts/smoke-dist.mjs",
    "lint": "echo 'No lint configured for react package'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
