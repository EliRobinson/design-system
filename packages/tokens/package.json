{
  "name": "@elirobinson/tokens",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.mjs"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./palettes.css": "./src/palettes.css",
    "./mobile.css": "./src/mobile.css",
    "./tailwind.css": "./src/tailwind.css",
    "./tokens.json": "./src/tokens.json",
    "./parse-tokens-css": {
      "types": "./src/parse-tokens-css.d.mts",
      "default": "./src/parse-tokens-css.mjs"
    },
    "./token-stylesheets": {
      "types": "./src/token-stylesheets.d.mts",
      "default": "./src/token-stylesheets.mjs"
    },
    "./color": {
      "types": "./src/color.d.mts",
      "default": "./src/color.mjs"
    },
    "./contrast": {
      "types": "./src/contrast.d.mts",
      "default": "./src/contrast.mjs"
    },
    "./tokens-data": {
      "types": "./dist/tokens-data.d.ts",
      "import": "./dist/tokens-data.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "node scripts/build-fonts.mjs && node scripts/build-tokens-json.mjs && rm -rf dist && tsc -p ./tsconfig.json",
    "lint": "echo 'No lint configured for tokens'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "prettier": "^3.8.3",
    "vitest": "^3.2.4"
  }
}
