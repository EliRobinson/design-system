{
  "name": "@elirobinson/tokens",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./tailwind.css": "./src/tailwind.css",
    "./tokens.json": "./src/tokens.json",
    "./tokens-data": {
      "types": "./dist/tokens-data.d.ts",
      "import": "./dist/tokens-data.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf dist && tsc -p ./tsconfig.json",
    "lint": "echo 'No lint configured for tokens'",
    "test": "echo 'No tests configured for tokens'"
  }
}
