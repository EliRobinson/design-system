{
  "name": "@elirobinson/tokens",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./src/tokens.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -p ./tsconfig.json",
    "lint": "echo 'No lint configured for tokens'",
    "test": "echo 'No tests configured for tokens'"
  }
}
