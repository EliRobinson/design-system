{
  "name": "@elirobinson/ai-patterns",
  "version": "0.28.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/ai-patterns"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "bin": {
    "ds-resync": "./src/resync/cli.mjs",
    "elirobinson-ds": "./src/cli/cli.mjs"
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md",
    "!src/**/*.test.mjs",
    "!src/**/*.test-helper.mjs",
    "!src/**/__fixtures__/**"
  ],
  "exports": {
    "./patterns": "./src/patterns.md",
    "./contracts": "./src/contracts.json",
    "./adherence": "./src/artifacts/adherence.mjs",
    "./brand-readme": "./dist/artifacts/skills/miltinson-design/README.md",
    "./prompts/*": "./src/prompts/*",
    "./agents/*": "./src/agents/*",
    "./resync/skill": "./src/resync/SKILL.md",
    "./voice/resolve": "./src/voice/resolve.mjs",
    "./voice/render": "./src/voice/render.mjs",
    "./corpus": {
      "types": "./src/artifacts/llms.d.ts",
      "import": "./src/artifacts/llms.mjs",
      "require": "./src/artifacts/llms.mjs"
    },
    "./artifacts": "./dist/artifacts/artifacts.json",
    "./artifacts/*": "./dist/artifacts/*",
    "./brand-manifest": {
      "types": "./dist/artifacts/brand-manifest.d.ts",
      "default": "./dist/artifacts/brand-manifest.json"
    },
    "./llms": "./dist/artifacts/skills/design-system-reference/llms.txt",
    "./llms-full": "./dist/artifacts/skills/design-system-reference/llms-full.txt",
    "./testing/playwright": {
      "types": "./src/testing/playwright.d.ts",
      "import": "./src/testing/playwright.mjs",
      "require": "./src/testing/playwright.mjs"
    },
    "./testing/visual-config": {
      "types": "./src/testing/visual-config.d.ts",
      "import": "./src/testing/visual-config.mjs",
      "require": "./src/testing/visual-config.mjs"
    },
    "./testing/visual-sweep": {
      "types": "./src/testing/visual-sweep.d.ts",
      "import": "./src/testing/visual-sweep.mjs",
      "require": "./src/testing/visual-sweep.mjs"
    },
    "./testing/preflight-sweep": {
      "types": "./src/testing/preflight-sweep.d.ts",
      "import": "./src/testing/preflight-sweep.mjs",
      "require": "./src/testing/preflight-sweep.mjs"
    },
    "./server": {
      "types": "./src/server/stream.d.ts",
      "import": "./src/server/stream.mjs"
    },
    "./server/prompt": {
      "types": "./src/server/prompt.d.ts",
      "import": "./src/server/prompt.mjs"
    },
    "./server/tools": {
      "types": "./src/server/tools.d.ts",
      "import": "./src/server/tools.mjs"
    },
    "./server/surfaces/decision-card": {
      "types": "./src/server/surfaces/decision-card.d.ts",
      "import": "./src/server/surfaces/decision-card.mjs"
    },
    "./server/surfaces/verdict-badge": {
      "types": "./src/server/surfaces/verdict-badge.d.ts",
      "import": "./src/server/surfaces/verdict-badge.mjs"
    },
    "./server/surfaces/stub-card": {
      "types": "./src/server/surfaces/stub-card.d.ts",
      "import": "./src/server/surfaces/stub-card.mjs"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "ai": ">=5.0.0",
    "axe-core": ">=4.8.0",
    "zod": ">=3.25.76"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-artifacts.mjs",
    "build:design-project": "node scripts/build-design-project.mjs",
    "sync:voice": "node scripts/sync-voice.mjs",
    "prepack": "node scripts/build-artifacts.mjs",
    "lint": "echo 'No lint configured for ai-patterns'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@elirobinson/react": "workspace:*",
    "@elirobinson/tokens": "workspace:*",
    "ai": "^7.0.92",
    "axe-core": "^4.11.0",
    "playwright": "^1.56.0",
    "vitest": "^3.2.4",
    "zod": "^4.5.4"
  }
}
