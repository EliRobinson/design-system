{
  "name": "@elirobinson/ai-patterns",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/ai-patterns"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "bin": {
    "ds-resync": "./src/resync/cli.mjs",
    "elirobinson-ds": "./src/cli/cli.mjs"
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md",
    "!src/**/*.test.mjs"
  ],
  "exports": {
    "./patterns": "./src/patterns.md",
    "./contracts": "./src/contracts.json",
    "./prompts/*": "./src/prompts/*",
    "./agents/*": "./src/agents/*",
    "./resync/skill": "./src/resync/SKILL.md",
    "./artifacts": "./dist/artifacts/artifacts.json",
    "./artifacts/*": "./dist/artifacts/*",
    "./llms": "./dist/artifacts/skills/design-system-reference/llms.txt",
    "./llms-full": "./dist/artifacts/skills/design-system-reference/llms-full.txt",
    "./testing/playwright": {
      "types": "./src/testing/playwright.d.ts",
      "import": "./src/testing/playwright.mjs"
    }
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "axe-core": ">=4.8.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-artifacts.mjs",
    "prepack": "node scripts/build-artifacts.mjs",
    "lint": "echo 'No lint configured for ai-patterns'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@elirobinson/tokens": "workspace:*",
    "axe-core": "^4.11.0",
    "playwright": "^1.56.0",
    "vitest": "^3.2.4"
  }
}
