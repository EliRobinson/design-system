{
  "name": "@elirobinson/eslint-config",
  "version": "0.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliRobinson/design-system.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.mjs"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./css": "./src/css.mjs",
    "./plugin": "./src/plugin.mjs"
  },
  "peerDependencies": {
    "@eslint/css": ">=1.0.0",
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@eslint/css": {
      "optional": true
    }
  },
  "scripts": {
    "build": "echo 'No build step required for eslint-config'",
    "lint": "echo 'No lint configured for eslint-config'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "eslint": "^9.39.4",
    "vitest": "^3.2.4"
  }
}
