{
  "name": "eslint-config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/eslint-config/src",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "pnpm run build",
      "options": {
        "cwd": "packages/eslint-config"
      }
    },
    "lint": {
      "command": "pnpm run lint",
      "options": {
        "cwd": "packages/eslint-config"
      }
    },
    "test": {
      "command": "pnpm run test",
      "options": {
        "cwd": "packages/eslint-config"
      }
    }
  }
}
