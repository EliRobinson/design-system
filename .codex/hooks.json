{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/scripts/agent-hooks/review-gate.mjs\" --agent=codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
